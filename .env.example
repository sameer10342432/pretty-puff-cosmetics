# ============================================================
# Pretty Puff Luxury Cosmetics — Environment Configuration
# ============================================================

# Application Environment (development or production)
NODE_ENV=production

# Server Port (cPanel automatically assigns PORT in production)
PORT=3000

# Base Public URL (Your public domain with https://)
APP_URL=https://yourdomain.com

# ------------------------------------------------------------
# Database Connection (MySQL / MariaDB for cPanel Hosting)
# ------------------------------------------------------------
# Option 1: Full Connection URL
DATABASE_URL="mysql://yourcpaneluser_ppadmin:YourSecretPassword123@localhost:3306/yourcpaneluser_prettypuff"

# Option 2: Individual variables (if preferred on cPanel)
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_NAME="yourcpaneluser_prettypuff"
# DB_USER="yourcpaneluser_ppadmin"
# DB_PASSWORD="YourSecretPassword123"

# For local development with SQLite (if MySQL not installed locally):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------
# Authentication Secrets
# ------------------------------------------------------------
AUTH_SECRET="prettypuff_super_secure_auth_secret_key_2026_luxury_cosmetics"
JWT_SECRET="prettypuff_super_secure_jwt_secret_key_2026_luxury_cosmetics"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------
# Administrator Initial Credentials (for seed.js)
# ------------------------------------------------------------
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourSecurePasswordHere123!"
ADMIN_NAME="Administrator"

# ------------------------------------------------------------
# Store Details & Contact
# ------------------------------------------------------------
STORE_NAME="Pretty Puff"
STORE_EMAIL="sameerliaqat81@gmail.com"
STORE_PHONE="+923474542881"
WHATSAPP_URL="https://wa.me/923474542881"
CURRENCY="PKR"

# ------------------------------------------------------------
# File Upload Directory (Local storage on cPanel)
# ------------------------------------------------------------
UPLOAD_DIR="./uploads"

# ------------------------------------------------------------
# Optional SMTP Email Configuration
# ------------------------------------------------------------
EMAIL_HOST="mail.yourdomain.com"
EMAIL_PORT="465"
EMAIL_USER="orders@yourdomain.com"
EMAIL_PASSWORD="YourEmailPassword"
EMAIL_FROM="orders@yourdomain.com"

